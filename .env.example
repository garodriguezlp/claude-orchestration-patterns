# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored, so your key never gets committed.

# Portkey gateway root. The Anthropic SDK adds /v1/messages itself, so do NOT add /v1 here.
PORTKEY_BASE_URL=https://api.portkey.ai

# Your Portkey API key (Portkey holds the real Anthropic key in its Model Catalog).
PORTKEY_API_KEY=your-portkey-api-key

# Model in Portkey's @provider-slug/model format.
MODEL=@anthropic/claude-sonnet-4-5-20250929
