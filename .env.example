# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored, so your credentials never get committed.
# These are the same variable names the Anthropic SDK and Claude Code use.

# API endpoint root. The SDK appends /v1/messages, so do not add /v1 here.
# Use Anthropic's API directly, or the URL of an Anthropic-compatible gateway.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Credential: set ONE of these.
#   ANTHROPIC_API_KEY    -> direct Anthropic API key (sent as x-api-key)
#   ANTHROPIC_AUTH_TOKEN -> gateway token (sent as Authorization: Bearer ...)
ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_AUTH_TOKEN=your-gateway-token

# Model ID as your endpoint expects it. Gateways may use their own naming.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional, gateways only: extra HTTP headers the gateway requires
# (for example, routing or tenant identification). One "Name: value" per line;
# separate multiple headers with \n inside double quotes.
# ANTHROPIC_CUSTOM_HEADERS="x-example-header: value"
